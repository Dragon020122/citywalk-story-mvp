{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "clientIdHash", "feedback", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "clientIdHash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storyId",
        "routePackId",
        "overallRating",
        "storyCoherence",
        "routeQuality",
        "taskQuality",
        "safetyFeeling",
        "likedTags",
        "issueTags",
        "comment",
        "fallbackUsed"
      ],
      "properties": {
        "storyId": { "type": "string", "minLength": 1 },
        "routePackId": { "type": "string", "minLength": 1 },
        "overallRating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "storyCoherence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "routeQuality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "taskQuality": { "type": "integer", "minimum": 1, "maximum": 5 },
        "safetyFeeling": { "type": "integer", "minimum": 1, "maximum": 5 },
        "likedTags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "issueTags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "comment": { "type": "string", "maxLength": 1000 },
        "fallbackUsed": { "type": "boolean" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "indexes": [
    { "fields": ["feedback.storyId"], "unique": false },
    { "fields": ["createdAt"], "unique": false }
  ],
  "clientPermissions": {
    "read": false,
    "write": false
  }
}
