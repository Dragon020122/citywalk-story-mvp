{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "story_sessions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "storyId",
    "clientIdHash",
    "preferences",
    "routePlan",
    "blueprint",
    "storyGraph",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "storyId": { "type": "string", "minLength": 1 },
    "clientIdHash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "preferences": { "type": "object" },
    "routePlan": { "type": "object" },
    "blueprint": { "type": "object" },
    "storyGraph": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "indexes": [
    { "fields": ["storyId"], "unique": false },
    { "fields": ["updatedAt"], "unique": false }
  ],
  "clientPermissions": {
    "read": false,
    "write": false
  }
}
