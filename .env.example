APP_CONTENT_MODE=mock
CLOUDBASE_ENV_ID=
AI_MODEL=deepseek-v4-flash

# Browser-only Tencent JavaScript API GL key.
VITE_TENCENT_MAP_BROWSER_KEY=
VITE_TENCENT_MAP_NAV_BASE_URL=https://apis.map.qq.com/uri/v1/routeplan
VITE_TENCENT_MAP_NAV_REFERER=citywalk-story

# Server-only Tencent WebService API key. Never prefix with VITE_.
TENCENT_MAP_SERVER_KEY=
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_GENERATE_PER_HOUR=8
RATE_LIMIT_REGENERATE_PER_HOUR=12
RATE_LIMIT_COMMON_PER_MINUTE=30
STORY_CACHE_TTL_HOURS=24
REQUEST_TIMEOUT_MS=65000
JSON_BODY_LIMIT=64kb
PORT=3000
POI_DATA_VERSION=mock-v1
NODE_ENV=development
