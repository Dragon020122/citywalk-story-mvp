{
  "name": "citywalk-story-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "cloudfunctions/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @citywalk/web",
    "dev:api": "npm run dev --workspace @citywalk/citywalk-api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace @citywalk/web",
    "build:api": "npm run build --workspace @citywalk/citywalk-api",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @citywalk/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
